{% extends 'complaints/base.html' %}
{% load static %}

{% block extra_css %}
<style>
    .feed-card {
        background: var(--surface-card);
        border: 1px solid var(--border-dim);
        border-radius: 24px;
        padding: 1.2rem 1.5rem;
        margin-bottom: 1.2rem;
        box-shadow: var(--shadow-sm);
        transition: 0.2s ease;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .feed-card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--brand-cyan);
    }
    .feed-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--brand-cyan);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
        overflow: hidden;
    }
    .feed-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .feed-body {
        flex: 1;
        min-width: 200px;
    }
    .feed-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
    }
    .feed-username {
        font-weight: 700;
        color: var(--text-primary);
    }
    .feed-action {
        color: var(--text-secondary);
    }
    .feed-time {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-left: auto;
    }
    .feed-complaint-summary {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
        background: var(--surface-dark);
        border-radius: 16px;
        padding: 0.8rem;
        align-items: center;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        color: inherit;
    }
    .feed-complaint-summary:hover {
        background: rgba(0,122,255,0.05);
    }
    .feed-complaint-thumb {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
        border: 1px solid var(--border-dim);
    }
    .feed-complaint-desc {
        flex: 1;
        font-size: 0.95rem;
        color: var(--text-secondary);
    }
    .feed-complaint-desc strong {
        color: var(--text-primary);
    }
    .feed-complaint-link {
        color: var(--brand-cyan);
        font-weight: 600;
        margin-left: 0.5rem;
        white-space: nowrap;
    }
    @media (max-width: 600px) {
        .feed-card {
            flex-direction: column;
            padding: 1rem;
        }
        .feed-avatar {
            width: 40px;
            height: 40px;
        }
        .feed-complaint-thumb {
            width: 60px;
            height: 60px;
        }
        .feed-complaint-summary {
            flex-wrap: wrap;
        }
        .feed-time {
            margin-left: 0;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="section-headline" style="margin-bottom:0;">📡 Activity Feed</h2>
            <p class="section-desc" style="margin-bottom:0;">See what's happening in your community – recent reports, comments, upvotes, and follows.</p>
        </div>
    </div>

    {% if activities %}
        {% for activity in activities %}
        <div class="feed-card">
            <!-- Avatar -->
            <div class="feed-avatar">
                {% if activity.avatar %}
                    <img src="{{ activity.avatar }}" alt="{{ activity.user.username }}">
                {% else %}
                    {{ activity.user.username|slice:":1"|upper }}
                {% endif %}
            </div>

            <!-- Body -->
            <div class="feed-body">
                <div class="feed-meta">
                    <span class="feed-username">{{ activity.user.username }}</span>
                    <span class="feed-action">{{ activity.action }}</span>
                    <span class="feed-time">{{ activity.timesince }} ago</span>
                </div>

                <!-- Complaint summary (clickable) -->
                <a href="{% url 'complaint_detail' activity.complaint_id %}" class="feed-complaint-summary">
                    {% if activity.complaint_photo %}
                        <img src="{{ activity.complaint_photo }}" alt="Complaint photo" class="feed-complaint-thumb">
                    {% else %}
                        <div class="feed-complaint-thumb" style="background:var(--border-dim); display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:0.7rem;">📷</div>
                    {% endif %}
                    <div class="feed-complaint-desc">
                        <strong>#{{ activity.complaint_id }}</strong>
                        {{ activity.complaint_desc|default:"No description" }}
                        {% if activity.type == 'comment' %}
                            <br><span style="color:var(--text-muted); font-size:0.85rem;">💬 "{{ activity.comment_text }}"</span>
                        {% endif %}
                    </div>
                    <span class="feed-complaint-link">View →</span>
                </a>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="text-center py-5 text-muted">
            <i class="fas fa-inbox fa-3x mb-3"></i>
            <p>No activity yet. Be the first to report an issue!</p>
        </div>
    {% endif %}
</div>
{% endblock %}

