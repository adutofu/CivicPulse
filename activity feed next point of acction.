# complaints/views.py
from django.contrib.auth.decorators import login_required
from django.shortcuts import render
from django.utils.timesince import timesince
from .models import Complaint, Comment, Vote, Repost, ComplaintFollower

@login_required
def activity_feed(request):
    # Get recent activities (same as before)
    complaints = Complaint.objects.filter(is_hidden=False).order_by('-created_at')[:10]
    comments = Comment.objects.order_by('-created_at')[:10]
    votes = Vote.objects.select_related('complaint', 'user').order_by('-created_at')[:10]
    follows = ComplaintFollower.objects.select_related('complaint', 'user').order_by('-created_at')[:10]
    reposts = Repost.objects.select_related('complaint', 'user').order_by('-created_at')[:10]

    activities = []

    for c in complaints:
        activities.append({
            'type': 'complaint',
            'user': c.citizen,
            'action': 'reported a new issue',
            'complaint': c,
            'complaint_photo': c.photo.url if c.photo else None,
            'complaint_desc': c.description[:120],
            'complaint_id': c.id,
            'created_at': c.created_at,
            'timesince': timesince(c.created_at),
        })

    for c in comments:
        activities.append({
            'type': 'comment',
            'user': c.author,
            'action': f'commented on complaint #{c.complaint.id}',
            'complaint': c.complaint,
            'complaint_photo': c.complaint.photo.url if c.complaint.photo else None,
            'complaint_desc': c.complaint.description[:120],
            'complaint_id': c.complaint.id,
            'comment_text': c.text[:60],
            'created_at': c.created_at,
            'timesince': timesince(c.created_at),
        })

    for v in votes:
        activities.append({
            'type': 'upvote',
            'user': v.user,
            'action': f'upvoted complaint #{v.complaint.id}',
            'complaint': v.complaint,
            'complaint_photo': v.complaint.photo.url if v.complaint.photo else None,
            'complaint_desc': v.complaint.description[:120],
            'complaint_id': v.complaint.id,
            'created_at': v.created_at,
            'timesince': timesince(v.created_at),
        })

    for f in follows:
        activities.append({
            'type': 'follow',
            'user': f.user,
            'action': f'started following complaint #{f.complaint.id}',
            'complaint': f.complaint,
            'complaint_photo': f.complaint.photo.url if f.complaint.photo else None,
            'complaint_desc': f.complaint.description[:120],
            'complaint_id': f.complaint.id,
            'created_at': f.created_at,
            'timesince': timesince(f.created_at),
        })

    for r in reposts:
        activities.append({
            'type': 'repost',
            'user': r.user,
            'action': f'reposted complaint #{r.complaint.id}',
            'complaint': r.complaint,
            'complaint_photo': r.complaint.photo.url if r.complaint.photo else None,
            'complaint_desc': r.complaint.description[:120],
            'complaint_id': r.complaint.id,
            'created_at': r.created_at,
            'timesince': timesince(r.created_at),
        })

    # Sort by created_at descending
    activities = sorted(activities, key=lambda x: x['created_at'], reverse=True)[:30]

    # Add user avatar URLs (using UI Avatars API for fallback)
    for act in activities:
        user = act['user']
        # If you have a Profile model with avatar field:
        # avatar_url = user.profile.avatar.url if user.profile.avatar else f"https://ui-avatars.com/api/?name={user.username}&background=007AFF&color=fff&size=40"
        avatar_url = f"https://ui-avatars.com/api/?name={user.username}&background=007AFF&color=fff&size=40"
        act['avatar'] = avatar_url

    return render(request, 'complaints/activity_feed.html', {'activities': activities})

